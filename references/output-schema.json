{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:handmade-story-visuals:output-schema:1.0",
  "title": "Handmade Story Visuals Prompt Package",
  "type": "object",
  "required": [
    "schema_version",
    "selected_style",
    "inputs",
    "prompt",
    "negative_prompt",
    "quality_checks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "selected_style": {
      "type": "object",
      "required": ["id", "slug", "name", "selection_mode", "matched_keywords"],
      "properties": {
        "id": {"type": "string", "pattern": "^S[0-9]{2}$"},
        "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "selection_mode": {
          "enum": ["explicit", "automatic", "fallback"]
        },
        "matched_keywords": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": [
        "subject",
        "intent",
        "aspect",
        "visible_text",
        "character_locks",
        "series_context"
      ],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "intent": {"type": "string"},
        "aspect": {"type": ["string", "null"]},
        "visible_text": {"type": "array", "items": {"type": "string"}},
        "character_locks": {"type": "array", "items": {"type": "string"}},
        "series_context": {"type": "string"}
      },
      "additionalProperties": false
    },
    "prompt": {"type": "string", "minLength": 1},
    "negative_prompt": {"type": "string", "minLength": 1},
    "quality_checks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 3
    }
  },
  "additionalProperties": false
}
